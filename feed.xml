---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>WAISL — Wireless AI Systems Lab</title>
    <link>{{ site.url | xml_escape }}</link>
    <description>{{ site.description | xml_escape }}</description>
    {% assign publications = site.data.publications | where: 'status', 'Published' | sort: 'feed_date' | reverse %}
    {% for pub in publications %}
    <item>
      <title>{{ pub.title | xml_escape }}</title>
      <link>{{ pub.paper_url | xml_escape }}</link>
      <guid isPermaLink="false">{{ pub.feed_id | default: pub.id | absolute_url | xml_escape }}</guid>
      {% if pub.feed_date %}<pubDate>{{ pub.feed_date | date_to_rfc822 }}</pubDate>{% endif %}
      <description>{{ pub.abstract | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
